{
  "manifest_version": 3,
  "name": "Epiphany",
  "version": "0.5",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:7676/"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+S" },
      "description": "Pull this page into Epiphany"
    }
  },
  "action": {
    "default_title": "Pull into Epiphany",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.donmai.us/*",
        "*://gelbooru.com/*",
        "*://safebooru.org/*",
        "*://yande.re/*",
        "*://konachan.com/*",
        "*://konachan.net/*",
        "*://*.sankakucomplex.com/*",
        "*://e621.net/*",
        "*://e926.net/*",
        "*://rule34.xxx/*",
        "*://*.zerochan.net/*",
        "*://anime-pictures.net/*",
        "*://e-hentai.org/*",
        "*://exhentai.org/*",
        "*://*.pixiv.net/*",
        "*://x.com/*",
        "*://twitter.com/*",
        "*://*.deviantart.com/*",
        "*://*.artstation.com/*",
        "*://*.fanbox.cc/*",
        "*://fantia.jp/*",
        "*://bsky.app/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}
