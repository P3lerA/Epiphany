{
  "name": "electron-app",
  "version": "0.0.5",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "test": "node test/extension-queue.mjs && electron test/tagger.js",
    "smoke": "node test/smoke.mjs"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "description": "Collect booru pictures into per-project training sets.",
  "build": {
    "appId": "dev.alice.epiphany",
    "productName": "Epiphany",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "motion.js",
      "piles.js",
      "preview.js",
      "settings.js",
      "spinners.js",
      "tasks.js",
      "profiles.js",
      "tagger.js",
      "theme.js",
      "index.html",
      "style.css",
      "package.json",
      "build/icon.png",
      "!node_modules/onnxruntime-node/bin/napi-v6/{darwin,linux}/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/bin/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "extension",
        "to": "extension"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "P3lerA",
      "repo": "Epiphany"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "onnxruntime-node": "^1.30.0"
  }
}
