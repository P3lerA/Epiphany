{
  "name": "epiphany",
  "version": "0.1.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "test": "node profiles.js && node share.js && node sites.js && node test/extension-queue.mjs && electron test/tagger.js",
    "smoke": "node test/smoke.mjs"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "description": "Collect booru pictures into per-project training sets.",
  "build": {
    "appId": "dev.alice.epiphany",
    "productName": "Epiphany",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "motion.js",
      "piles.js",
      "preview.js",
      "settings.js",
      "spinners.js",
      "tasks.js",
      "profiles.js",
      "tagger.js",
      "share.js",
      "gdl.js",
      "sites.js",
      "quotes.js",
      "theme.js",
      "glass.js",
      "index.html",
      "style.css",
      "package.json",
      "build/icon.png",
      "build/icon-mac.png",
      "!node_modules/onnxruntime-node/bin/napi-v6/**",
      "node_modules/onnxruntime-node/bin/napi-v6/${platform}/${arch}/**"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/bin/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": "arm64"
        },
        {
          "target": "zip",
          "arch": "arm64"
        }
      ],
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Epiphany-${version}-mac.${ext}"
    },
    "nsis": {
      "artifactName": "Epiphany-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "extension",
        "to": "extension"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "P3lerA",
      "repo": "Epiphany"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "onnxruntime-node": "^1.30.0"
  }
}
